# ============================================================
#  إعدادات البوت — انسخ هذا الملف إلى .env واملأ القيم
# ============================================================

# ---- تلغرام ----
# احصل على التوكن من @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# معرّفات الأدمن (مفصولة بفواصل) — احصل على معرّفك من @userinfobot
ADMIN_IDS=123456789

# ---- NOWPayments ----
# مفتاح الـ API من لوحة تحكم NOWPayments
NOWPAYMENTS_API_KEY=your_api_key_here
# سرّ IPN من إعدادات NOWPayments (للتحقق من الإشعارات)
NOWPAYMENTS_IPN_SECRET=your_ipn_secret_here
# (اختياري) رابط API مخصص
NOWPAYMENTS_API_URL=https://api.nowpayments.io

# ---- خادم الإشعارات ----
WEBHOOK_PORT=3000
WEBHOOK_PATH=/webhooks/nowpayments
# الرابط العام (HTTPS) الذي يستقبل إشعارات NOWPayments — مثال:
# PUBLIC_URL=https://mybot.example.com
# أثناء التطوير يمكنك استخدام: ngrok http 3000 ثم وضع الرابط هنا
PUBLIC_URL=

# ---- الأرباح والمبالغ ----
# العملة الأساسية للتسعير (الدولار)
CURRENCY=usd
# الحد الأدنى للإيداع والسحب (بالدولار)
MIN_DEPOSIT=10
MIN_WITHDRAW=5

# ---- المهام المجدولة ----
# كل كم ثانية تُتابع الفواتير المعلّقة (احتياطي إذا لم يصل الـ Webhook)
DEPOSIT_POLL_SECONDS=60
# ساعة صرف الأرباح اليومية (0-23 بتوقيت السيرفر)
PAYOUT_HOUR=0

# ---- قاعدة البيانات ----
DB_PATH=./data/bot.db

# ---- للمنصات ذات القرص المؤقت (مثل Koyeb المجاني) ----
# رابط الخدمة العام — ترسله مهمة النبض الذاتي كل 10 دقائق
# لمنع الخدمة من "النوم" بعد ساعة بلا طلب
SELF_PING_URL=
SELF_PING_MINUTES=10

# ---- متقدم (اختياري) ----
# عنوان API تلغرام بديل (للاستخدام مع Bot API Server محلي أو الاختبارات)
TELEGRAM_API_ROOT=

# ---- السحب التلقائي (اختياري) ----
# بيانات حساب NOWPayments لواجهة السحب — إن تركتها فارغة
# تتم الموافقة على السحوبات يدوياً من لوحة الأدمن
NOWPAYMENTS_PAYOUTS_EMAIL=
NOWPAYMENTS_PAYOUTS_PASSWORD=
